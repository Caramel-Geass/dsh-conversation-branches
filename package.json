{
  "name": "@deepseek-ai/dsh-conversation-branches",
  "description": "Conversation branches: select main-conversation text to open IM-style Q&A branches in the right details column",
  "version": "0.1.0-rc.6",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "plugin",
    "conversation-branches",
    "conversation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Caramel-Geass/dsh-conversation-branches.git"
  },
  "homepage": "https://github.com/Caramel-Geass/dsh-conversation-branches#readme",
  "bugs": {
    "url": "https://github.com/Caramel-Geass/dsh-conversation-branches/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/dsh-client-connection": "^0.1.0-rc.6"
  },
  "license": "MIT"
}
